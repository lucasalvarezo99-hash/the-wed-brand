# Copiar este archivo como .env y completar. Todas son públicas (no hay secretos).

# Dominio definitivo del sitio, sin barra final.
PUBLIC_SITE_URL=https://thewedbrand.com.ar

# Endpoint del formulario de contacto (ej. https://formspree.io/f/xxxxxxx).
# Vacío = el formulario abre un mail prearmado en lugar de enviar.
PUBLIC_FORM_ENDPOINT=

# Google Analytics 4 (ej. G-XXXXXXXXXX). Vacío = sin analítica ni aviso de cookies.
PUBLIC_GA_ID=

# WhatsApp en formato internacional, sin espacios (ej. 5491100000000). Vacío = no se muestra.
PUBLIC_WHATSAPP=
