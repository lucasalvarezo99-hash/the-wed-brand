---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';
import {
  hero,
  heroReel,
  philosophy,
  servicesIntro,
  servicePhotos,
  serviceGuide,
  brands,
  applications,
  strip,
  portfolioIntro,
  meeting,
  contactIntro,
} from '../data/home';
import faq from '../data/faq.json';
import proceso from '../data/proceso.json';
import equipo from '../data/equipo.json';
import testimonios from '../data/testimonios.json';
import fotoEquipo from '../assets/nosotras/cande-y-casu.jpg';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const serviceTitle = (slug: string) => servicios.find((s) => s.id === slug)?.data.title ?? slug;

const proyectos = (await getCollection('proyectos', ({ data }) => data.published)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order,
);
const featured = proyectos.filter((p) => p.data.featured);
const rest = proyectos.filter((p) => !p.data.featured);
// Filtros solo cuando hay suficientes proyectos para que sean útiles.
const categories = [...new Set(proyectos.flatMap((p) => p.data.categories))];
const showFilters = proyectos.length >= 4 && categories.length > 1;

type Testimonio = { quote: string; author: string };
const quotes = testimonios as Testimonio[];

// Marca grande del inicio, letra por letra para repartirla de lado a lado.
const wordmark = [...'THE WED BRAND'];

const bookingHref = site.bookingUrl || '#contacto';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base jsonLd={faqLd}>
  <!-- ============================================================ INICIO -->
  <section class="hero" id="inicio" aria-labelledby="hero-title">
    <div class="container">
      <h1 class="wordmark" id="hero-title">
        <span class="visually-hidden">The Wed Brand — branding e identidad para casamientos</span>
        <span class="wordmark__letters" aria-hidden="true">
          {wordmark.map((ch, i) => (
            <span class:list={['wordmark__ch', { 'wordmark__sp': ch === ' ' }]} style={`--i:${i}`}>{ch === ' ' ? '' : ch}</span>
          ))}
        </span>
      </h1>
      <p class="hero__manifesto justify">{hero.manifesto}</p>
      <div class="hero__actions">
        <a class="bracket-link" href={hero.primary.href}>{hero.primary.label.toLowerCase()}</a>
        <a class="bracket-link" href={hero.secondary.href}>{hero.secondary.label.toLowerCase()}</a>
      </div>
    </div>

    <div class="reel" aria-label="Algunos trabajos y aplicaciones">
      <ul class="reel__track">
        {[0, 1].map((copy) =>
          heroReel.map((item, i) => (
            <li class="reel__item" aria-hidden={copy === 1 ? 'true' : undefined}>
              <p class="reel__meta tracked">
                <span>[ {item.tag}</span>
                <span>{String(i + 1).padStart(2, '0')} ]</span>
              </p>
              <div class="reel__img">
                <Image
                  src={item.src}
                  alt={copy === 1 ? '' : item.alt}
                  widths={[220, 340, 460]}
                  sizes="(min-width: 900px) 16vw, 42vw"
                  loading={copy === 0 && i < 6 ? 'eager' : 'lazy'}
                />
              </div>
            </li>
          )),
        )}
      </ul>
    </div>
  </section>

  <!-- ============================================================ CÓMO PENSAMOS -->
  <section class="section note" id="filosofia" aria-labelledby="filosofia-title">
    <div class="container note__grid">
      <figure class="note__photo reveal">
        <Image src={philosophy.photo.src} alt={philosophy.photo.alt} widths={[320, 480, 640]} sizes="(min-width: 900px) 24vw, 80vw" />
      </figure>
      <div class="note__text">
        <SectionHead title={philosophy.title} id="filosofia-title">
          {philosophy.paragraphs.map((p) => <p class="justify">{p}</p>)}
        </SectionHead>
      </div>
    </div>
    <figure class="quote reveal">
      <figcaption class="tracked">{philosophy.quoteLabel}</figcaption>
      <blockquote><p class="script">«{philosophy.quote}»</p></blockquote>
    </figure>
  </section>

  <!-- ============================================================ SERVICIOS -->
  <section class="section services" id="servicios" aria-labelledby="servicios-title">
    <div class="container">
      <div class="split-head">
        <SectionHead title={servicesIntro.title} id="servicios-title" />
        <p class="reveal">{servicesIntro.lead}</p>
      </div>

      <ul class="svc-grid">
        {servicios.map((s, i) => (
          <li class="svc reveal" id={`servicio-${s.id}`} style={`--delay:${i * 0.08}s`}>
            {servicePhotos[s.id] && (
              <figure class="svc__photo">
                <Image src={servicePhotos[s.id].src} alt={servicePhotos[s.id].alt} widths={[300, 460, 600]} sizes="(min-width: 1100px) 22vw, (min-width: 640px) 45vw, 90vw" />
              </figure>
            )}
            <h3 class="svc__title tracked-title">{s.data.title}</h3>
            <p class="svc__tagline">{s.data.tagline}</p>
            <p class="svc__summary justify">{s.data.summary}</p>
            <details class="svc__more">
              <summary>(qué puede incluir)</summary>
              <ul class="arrow-list">{s.data.includes.map((item) => <li>{item}</li>)}</ul>
              <p class="tracked svc__sub">Para ustedes si…</p>
              <ul class="arrow-list">{s.data.idealFor.map((item) => <li>{item}</li>)}</ul>
              {s.data.note && <p class="svc__note">{s.data.note}</p>}
            </details>
            <div class="svc__links">
              <a class="bracket-link" href={`/servicios/${s.id}`}>ver más</a>
              <a class="bracket-link" href={`/?servicio=${s.id}#contacto`} data-preselect={s.id}>consultar</a>
            </div>
          </li>
        ))}
      </ul>

      <div class="services__extra">
        <div class="custom reveal">
          <h3 class="tracked-title">{servicesIntro.custom.title}</h3>
          <p>{servicesIntro.custom.text}</p>
          <a class="bracket-link" href="/?servicio=no-se#contacto" data-preselect="no-se">cuéntennos su idea</a>
        </div>
        <div class="guide reveal">
          <h3 class="tracked-title">{serviceGuide.title}</h3>
          <ul class="guide__list">
            {serviceGuide.items.map((g) => (
              <li>
                <span>{g.situation}</span>
                <a href={`#servicio-${g.service}`}>{serviceTitle(g.service)} <ArrowIcon class="guide__arrow" /></a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ FRANJA DE FOTOS -->
  <section class="strip" aria-label="Fotografía">
    <ul class="strip__list">
      {strip.map((ph, i) => (
        <li class="strip__item reveal" style={`--delay:${i * 0.08}s`}>
          <Image src={ph.src} alt={ph.alt} widths={[300, 460, 600]} sizes="(min-width: 900px) 18vw, 60vw" />
        </li>
      ))}
    </ul>
  </section>

  <!-- ============================================================ MARCAS (lámina verde) -->
  <section class="section tone-oliva on-dark brands" id="marcas" aria-labelledby="marcas-title">
    <div class="container brands__grid">
      <div class="brands__photos reveal">
        <figure><Image src={brands.photo.src} alt={brands.photo.alt} widths={[300, 460]} sizes="(min-width: 900px) 20vw, 45vw" /></figure>
        <figure><Image src={brands.photo2.src} alt={brands.photo2.alt} widths={[300, 460]} sizes="(min-width: 900px) 20vw, 45vw" /></figure>
      </div>
      <div class="brands__text">
        <SectionHead title={brands.title} id="marcas-title">
          {brands.paragraphs.map((p) => <p class="justify">{p}</p>)}
          <a class="btn btn--light" href={`/?servicio=${brands.cta.service}#contacto`} data-preselect={brands.cta.service}>{brands.cta.label}</a>
        </SectionHead>
      </div>
    </div>
  </section>

  <!-- ============================================================ APLICACIONES -->
  <section class="section applications" id="aplicaciones" aria-labelledby="aplicaciones-title">
    <div class="container">
      <div class="split-head">
        <SectionHead title={applications.title} id="aplicaciones-title" />
        <p class="reveal">{applications.lead}</p>
      </div>
      <ul class="apps">
        {applications.items.map((it, i) => (
          <li class="apps__item reveal" style={`--delay:${(i % 4) * 0.07}s`}>
            <figure>
              <div class="apps__img"><Image src={it.src} alt={it.alt} widths={[280, 420, 560]} sizes="(min-width: 1000px) 20vw, 45vw" /></div>
              <figcaption class="tracked">{it.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============================================================ PORTFOLIO -->
  <section class="section portfolio section-rule" id="portfolio" aria-labelledby="portfolio-title">
    <div class="container">
      <div class="split-head">
        <SectionHead title={portfolioIntro.title} id="portfolio-title" />
        <p class="reveal">{portfolioIntro.lead}</p>
      </div>

      {showFilters && (
        <div class="filters" role="group" aria-label="Filtrar proyectos" data-filters>
          <button type="button" class="bracket-link" aria-pressed="true" data-filter="*">todos</button>
          {categories.map((c) => <button type="button" class="bracket-link" aria-pressed="false" data-filter={c}>{c.toLowerCase()}</button>)}
        </div>
      )}

      <div class="portfolio__featured">
        {featured.map((p) => <div class="reveal"><ProjectCard project={p} featured /></div>)}
      </div>
      {rest.length > 0 && <div class="portfolio__grid">{rest.map((p) => <div class="reveal"><ProjectCard project={p} /></div>)}</div>}

      <p class="portfolio__more reveal">
        {portfolioIntro.more}{' '}
        <a class="bracket-link" href={site.contact.instagram.url} target="_blank" rel="noopener">{site.contact.instagram.handle}</a>
      </p>
    </div>
  </section>

  <!-- ============================================================ QUIÉNES ESTÁN DETRÁS (lámina celeste) -->
  <section class="section tone-celeste about" id="nosotras" aria-labelledby="nosotras-title">
    <div class="container about__grid">
      <div class="about__text">
        <SectionHead title={equipo.title} id="nosotras-title">
          {equipo.paragraphs.map((p) => <p class="justify">{p}</p>)}
        </SectionHead>
        <dl class="about__people reveal">
          {equipo.people.map((person) => (
            <div>
              <dt class="tracked">{person.name} · {person.fullName}</dt>
              <dd>{person.role}</dd>
              {person.links.length > 0 && (
                <dd>{(person.links as { label: string; href: string }[]).map((l) => <a class="bracket-link" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}</dd>
              )}
            </div>
          ))}
        </dl>
      </div>
      <figure class="about__photo reveal">
        <Image src={fotoEquipo} alt={equipo.photoAlt} widths={[420, 640]} sizes="(min-width: 900px) 45vw, 90vw" />
      </figure>
    </div>
  </section>

  <!-- ============================================================ PROCESO -->
  <section class="section process" id="proceso" aria-labelledby="proceso-title">
    <div class="container">
      <div class="split-head">
        <SectionHead title={['Cómo', 'trabajamos']} id="proceso-title" />
        <p class="reveal">{proceso.note}</p>
      </div>
      <ol class="steps">
        {proceso.steps.map((s, i) => (
          <li class="reveal" style={`--delay:${i * 0.07}s`}>
            <span class="tracked">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="tracked-title">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============================================================ REUNIÓN INICIAL (lámina bordó) -->
  <section class="section tone-vino on-dark meeting" id="reunion" aria-labelledby="reunion-title">
    <div class="container meeting__inner">
      <h2 class="head__title reveal" id="reunion-title"><span>{meeting.title}</span></h2>
      <p class="meeting__text reveal">{meeting.text}</p>
      <p class="tracked meeting__badge reveal">• {meeting.badge} •</p>
      <p class="reveal">{meeting.note}</p>
      <a
        class="btn btn--light reveal"
        href={bookingHref}
        {...(site.bookingUrl ? { target: '_blank', rel: 'noopener' } : { 'data-preselect': 'reunion' })}
      >{meeting.cta}</a>
    </div>
  </section>

  <!-- ============================================================ TESTIMONIOS (se oculta si no hay) -->
  {quotes.length > 0 && (
    <section class="section testimonials" id="testimonios" aria-labelledby="testimonios-title">
      <div class="container">
        <SectionHead title={['Lo que dicen', 'las parejas']} id="testimonios-title" />
        <ul class="testimonials__list">
          {quotes.map((t) => (
            <li class="reveal"><figure><blockquote><p>«{t.quote}»</p></blockquote><figcaption class="tracked">{t.author}</figcaption></figure></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ============================================================ FAQ -->
  <section class="section faq" id="preguntas" aria-labelledby="preguntas-title">
    <div class="container faq__grid">
      <SectionHead title={['Preguntas', 'frecuentes']} id="preguntas-title">
        <p>¿Les queda alguna duda? <a class="bracket-link" href="#contacto">escríbannos</a></p>
      </SectionHead>
      <div class="faq__list">
        {faq.map((f) => (
          <details class="faq__item">
            <summary><span>{f.q}</span><span class="faq__icon" aria-hidden="true"></span></summary>
            <div class="faq__answer"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================ CONTACTO -->
  <section class="section contact section-rule" id="contacto" aria-labelledby="contacto-title">
    <div class="container">
      <h2 class="contact__title script reveal" id="contacto-title">{contactIntro.title}</h2>
      <p class="contact__lead reveal">{contactIntro.lead}</p>
      <ContactForm services={servicios.map((s) => ({ slug: s.id, title: s.data.title }))} />
      <p class="contact__direct">
        <span class="tracked">O directamente</span>
        <a class="bracket-link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <a class="bracket-link" href={site.contact.instagram.url} target="_blank" rel="noopener">instagram {site.contact.instagram.handle}</a>
        {site.contact.whatsapp && <a class="bracket-link" href={`https://wa.me/${site.contact.whatsapp}`} target="_blank" rel="noopener">whatsapp</a>}
      </p>
    </div>
  </section>
</Base>

{showFilters && (
  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filters] [data-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('#portfolio [data-categories]')];
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filter!;
        buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        cards.forEach((c) => (c.parentElement!.hidden = !(f === '*' || c.dataset.categories!.split('|').includes(f))));
      }),
    );
  </script>
)}

<style>
  /* Títulos de bloque chicos, mayúsculas espaciadas */
  .tracked-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.5;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .split-head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  @media (min-width: 900px) {
    .split-head { grid-template-columns: 1fr 1fr; align-items: end; column-gap: var(--gutter); }
    .split-head > p { max-width: 46ch; justify-self: end; }
  }

  /* ------------------------------------------------ inicio (ref. Solamente) */
  .hero { padding-top: clamp(1.5rem, 4vw, 3.5rem); padding-bottom: clamp(3rem, 6vw, 5rem); overflow: hidden; }
  .wordmark { margin: 0; color: var(--vino); }
  .wordmark__letters {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.2rem, 11.2vw, 15rem);
    line-height: 0.9;
    text-transform: uppercase;
  }
  .wordmark__ch { display: inline-block; animation: letter-in 1s var(--ease) both; animation-delay: calc(var(--i) * 0.045s); }
  .wordmark__sp { width: 0.15em; }
  @keyframes letter-in { from { opacity: 0; transform: translateY(0.25em); } }

  .hero__manifesto {
    max-width: none;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-display);
    font-size: clamp(0.72rem, 0.66rem + 0.25vw, 0.92rem);
    line-height: 2;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    animation: fade-in 1.2s var(--ease) 0.5s both;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin-top: 1.5rem; animation: fade-in 1.2s var(--ease) 0.7s both; }
  @keyframes fade-in { from { opacity: 0; } }

  /* Tira de fotos que se desliza de derecha a izquierda */
  .reel { margin-top: clamp(2.5rem, 5vw, 4rem); overflow: hidden; }
  .reel__track {
    list-style: none;
    padding: 0;
    display: flex;
    gap: clamp(0.9rem, 1.6vw, 1.5rem);
    width: max-content;
    animation: reel 70s linear infinite;
  }
  .reel:hover .reel__track { animation-play-state: paused; }
  @keyframes reel { to { transform: translateX(calc(-50% - clamp(0.9rem, 1.6vw, 1.5rem) / 2)); } }
  .reel__item { width: clamp(150px, 15vw, 240px); flex: none; display: grid; gap: 0.6rem; }
  .reel__meta { display: flex; justify-content: space-between; gap: 0.5rem; font-size: 0.66rem; white-space: nowrap; overflow: hidden; }
  .reel__img { aspect-ratio: 3 / 4; overflow: hidden; background: var(--line-soft); }
  .reel__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .reel__item:hover .reel__img :global(img) { transform: scale(1.04); }
  @media (prefers-reduced-motion: reduce) {
    .reel { overflow-x: auto; }
    .reel__track { animation: none; padding-inline: var(--gutter); }
  }

  /* ------------------------------------------------ nota (ref. Kennedy) */
  .note__grid { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .note__photo { margin: 0; max-width: 360px; }
  .note__photo :global(img) { width: 100%; }
  .note__text { max-width: 440px; }
  .note__text :global(.head__lead) { display: grid; gap: 1.2rem; }
  @media (min-width: 900px) {
    .note__grid { grid-template-columns: 1fr 1fr; }
    .note__text { justify-self: end; margin-top: clamp(4rem, 9vw, 9rem); margin-right: 6vw; }
  }
  .quote { margin: var(--section-y) auto 0; text-align: center; display: grid; gap: 1rem; padding-inline: var(--gutter); }
  .quote blockquote p { max-width: none; color: var(--vino); font-size: clamp(3rem, 1.5rem + 6vw, 7.5rem); line-height: 1.1; }

  /* ------------------------------------------------ servicios */
  .svc-grid { list-style: none; padding: 0; display: grid; gap: clamp(3rem, 5vw, 4rem) var(--gutter); }
  @media (min-width: 640px) { .svc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .svc-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .svc { display: grid; gap: 0.9rem; align-content: start; scroll-margin-top: calc(var(--header-h) + 1rem); }
  .svc__photo { margin: 0 0 0.6rem; aspect-ratio: 4 / 5; overflow: hidden; }
  .svc__photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .svc:hover .svc__photo :global(img) { transform: scale(1.03); }
  .svc__title { min-height: 3em; }
  .svc__tagline { color: var(--vino); }
  .svc__summary { font-size: 0.86rem; }
  .svc__more summary { cursor: pointer; list-style: none; font-size: 0.86rem; color: var(--vino); }
  .svc__more summary::-webkit-details-marker { display: none; }
  .svc__more[open] summary { margin-bottom: 0.8rem; }
  .svc__more .arrow-list { font-size: 0.82rem; gap: 0.35rem; }
  .svc__sub { margin: 1rem 0 0.5rem; }
  .svc__note { margin-top: 0.9rem; font-size: 0.78rem; padding-top: 0.8rem; border-top: 1px solid var(--line-soft); }
  .svc__links { display: flex; flex-wrap: wrap; gap: 0.3rem 1.4rem; font-size: 0.86rem; }

  .services__extra { display: grid; gap: 3rem; margin-top: clamp(4rem, 7vw, 6rem); padding-top: 3rem; border-top: 1px solid var(--line-soft); }
  @media (min-width: 900px) { .services__extra { grid-template-columns: 1fr 1.6fr; gap: var(--gutter); } }
  .custom { display: grid; gap: 1rem; align-content: start; max-width: 38ch; }
  .guide { display: grid; gap: 1rem; }
  .guide__list { list-style: none; padding: 0; }
  .guide__list li { display: grid; gap: 0.3rem 2rem; padding: 0.8rem 0; border-top: 1px solid var(--line-soft); font-size: 0.86rem; }
  .guide__list a { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--vino); text-decoration: none; font-family: var(--font-display); font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .guide__list a:hover { text-decoration: underline; }
  .guide__list :global(.guide__arrow) { width: 0.9rem; }
  @media (min-width: 700px) { .guide__list li { grid-template-columns: 1.5fr 1fr; align-items: center; } }

  /* ------------------------------------------------ franja */
  .strip { padding-block: 0 var(--section-y); }
  .strip__list { list-style: none; padding: 0 var(--gutter); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(0.5rem, 1.2vw, 1.2rem); max-width: 1600px; margin-inline: auto; }
  .strip__item { aspect-ratio: 3 / 4; overflow: hidden; }
  .strip__item:nth-child(even) { margin-top: clamp(1.5rem, 4vw, 4rem); }
  .strip__item :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 760px) {
