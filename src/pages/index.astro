---
/**
 * Inicio: solo el hero (referencia Solamente). El resto del sitio se navega
 * desde la barra superior: nosotras, servicios, portfolio, proceso, contacto.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { hero, heroReel } from '../data/home';
import '../styles/sections.css';

const wordmark = [...'THE WED BRAND'];
---
<Base footer={false}>
  <section class="hero hero--home" id="inicio" aria-labelledby="hero-title">
    <div class="container">
      <h1 class="wordmark" id="hero-title">
        <span class="visually-hidden">The Wed Brand — branding e identidad para casamientos</span>
        <span class="wordmark__letters" aria-hidden="true">
          {wordmark.map((ch, i) => (
            <span class:list={['wordmark__ch', { 'wordmark__sp': ch === ' ' }]} style={`--i:${i}`}>{ch === ' ' ? '' : ch}</span>
          ))}
        </span>
      </h1>
      <p class="hero__manifesto justify">{hero.manifesto}</p>
    </div>

    <div class="reel" aria-label="Algunos trabajos y aplicaciones">
      <ul class="reel__track">
        {[0, 1].map((copy) =>
          heroReel.map((item, i) => (
            <li class="reel__item" aria-hidden={copy === 1 || !item.src ? 'true' : undefined}>
              <div class:list={['reel__img', { 'reel__img--empty': !item.src }]}>
                {item.src && (
                  <Image
                    src={item.src}
                    alt={copy === 1 ? '' : item.alt}
                    widths={[220, 340, 460]}
                    sizes="(min-width: 900px) 16vw, 42vw"
                    loading={copy === 0 && i < 6 ? 'eager' : 'lazy'}
                  />
                )}
              </div>
            </li>
          )),
        )}
      </ul>
    </div>
  </section>
</Base>
