---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import { servicesIntro, servicePhotos, serviceGuide } from '../../data/home';
import '../../styles/sections.css';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const serviceTitle = (slug: string) => servicios.find((s) => s.id === slug)?.data.title ?? slug;
---
<Base title="Servicios" description="Tres servicios que pueden contratarse juntos o por separado: Branding & Wedding Design, Comunicación & Comunidad y Wedding Content.">
  <section class="section services" aria-labelledby="servicios-title">
    <div class="container">
      <div class="split-head">
        <SectionHead title={servicesIntro.title} id="servicios-title" as="h1" />
        {servicesIntro.lead && <p class="reveal">{servicesIntro.lead}</p>}
      </div>

      <ul class="svc-grid">
        {servicios.map((s, i) => (
          <li class="svc reveal" id={`servicio-${s.id}`} style={`--delay:${i * 0.08}s`}>
            <a class="svc__card" href={`/servicios/${s.id}`}>
              {servicePhotos[s.id] && (
                <figure class="svc__photo">
                  <Image src={servicePhotos[s.id].src} alt={servicePhotos[s.id].alt} widths={[360, 560, 760]} sizes="(min-width: 1000px) 30vw, (min-width: 640px) 45vw, 90vw" loading="eager" quality={90} />
                </figure>
              )}
              <span class="tracked svc__num">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="svc__title tracked-title">{s.data.title}</h2>
              <p class="svc__tagline">{s.data.tagline}</p>
              <span class="go-link">ver el servicio</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="services__extra">
        <div class="custom reveal">
          <h2 class="tracked-title">{servicesIntro.custom.title}</h2>
          <p>{servicesIntro.custom.text}</p>
          <a class="go-link" href="/contacto#servicio-no-se">cuéntennos su idea</a>
        </div>
        <div class="guide reveal">
          <h2 class="tracked-title">{serviceGuide.title}</h2>
          <ul class="guide__list">
            {serviceGuide.items.map((g) => (
              <li>
                <span>{g.situation}</span>
                <a href={`#servicio-${g.service}`}>{serviceTitle(g.service)} <ArrowIcon class="guide__arrow" /></a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

</Base>
