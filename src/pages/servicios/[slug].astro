---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import { site } from '../../config/site';
import { servicePhotos } from '../../data/home';
import '../../styles/sections.css';

export const getStaticPaths = (async () => {
  const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
  return servicios.map((servicio, i) => ({
    params: { slug: servicio.id },
    props: { servicio, index: i, all: servicios },
  }));
}) satisfies GetStaticPaths;

const { servicio, index, all } = Astro.props;
const s = servicio.data;
const others = all.filter((o) => o.id !== servicio.id);
const photo = servicePhotos[servicio.id];
const num = String(index + 1).padStart(2, '0');

const base = Astro.site;
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.title,
    description: s.summary,
    serviceType: s.seoTitle ?? s.title,
    provider: { '@id': '#organizacion' },
    areaServed: site.areaServed,
    ...(base ? { url: new URL(Astro.url.pathname, base).href } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', ...(base ? { item: base.origin + '/' } : {}) },
      { '@type': 'ListItem', position: 2, name: 'Servicios', ...(base ? { item: base.origin + '/servicios' } : {}) },
      { '@type': 'ListItem', position: 3, name: s.title },
    ],
  },
];
---
<Base title={s.seoTitle ?? s.title} description={s.seoDescription ?? s.summary} jsonLd={ld}>
  <article class="section svc-page">
    <div class="container">
      <nav class="crumbs tracked" aria-label="Ruta">
        <a href="/servicios">[ servicios ]</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{num}</span>
      </nav>

      <div class="svc-page__grid">
        {photo && (
          <figure class="svc-page__photo reveal">
            <Image src={photo.src} alt={photo.alt} widths={[360, 560, 760]} sizes="(min-width: 900px) 34vw, 90vw" loading="eager" />
          </figure>
        )}

        <div class="svc-page__text">
          <p class="tracked">{num}</p>
          <h1 class="head__title">{s.title}</h1>
          {s.kicker && <p class="tracked svc-page__kicker">{s.kicker}</p>}
          <p class="svc-page__summary justify">{s.summary}</p>
          {s.intro && <p>{s.intro}</p>}

          {s.highlight && (
            <p class="svc-page__highlight">
              <span class="svc-page__highlight-value">{s.highlight.value}</span>
              <span class="tracked">{s.highlight.label}</span>
            </p>
          )}

          <div class="svc-page__list">
            <h2 class="tracked">{s.includesLabel}</h2>
            <ul class="arrow-list">{s.includes.map((i) => <li>{i}</li>)}</ul>
          </div>

          {s.choices.length > 0 && (
            <div class="svc-page__list">
              <h2 class="tracked">{s.choicesLabel}</h2>
              <ul class="arrow-list">{s.choices.map((i) => <li>{i}</li>)}</ul>
            </div>
          )}

          {s.callout && (
            <div class="svc-page__callout">
              <p class="tracked">{s.callout.title}</p>
              <p>{s.callout.text}</p>
            </div>
          )}

          {s.note && <p class="svc-page__note">{s.note}</p>}

          <div class="svc-page__actions">
            <a class="btn btn--solid" href={`/contacto#servicio-${servicio.id}`}>Consultar</a>
            <a class="bracket-link" href="/servicios">volver a servicios</a>
          </div>
        </div>
      </div>

      <div class="svc-page__others">
        <p class="tracked">Otros servicios · se pueden contratar juntos o por separado</p>
        <ul>
          {others.map((o) => (
            <li>
              <a href={`/servicios/${o.id}`}>
                <span class="tracked-title">{o.data.title}</span>
                <span class="svc-page__others-tag">{o.data.tagline}</span>
                <ArrowIcon class="svc-page__arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </article>
</Base>

<style>
  .crumbs { display: flex; gap: 0.6rem; font-size: 0.7rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--vino); }

  .svc-page__grid { display: grid; gap: clamp(2.5rem, 5vw, 5rem); align-items: start; }
  .svc-page__photo { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; max-width: 520px; }
  .svc-page__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .svc-page__text { display: grid; gap: 1.4rem; max-width: 520px; align-content: start; }
  .svc-page__text .head__title { color: var(--vino); }
  .svc-page__kicker { color: var(--vino); }
  .svc-page__summary { font-size: var(--step-1); line-height: 1.7; }

  .svc-page__highlight { display: grid; gap: 0.2rem; padding-block: 1.2rem; border-block: 1px solid var(--line-soft); }
  .svc-page__highlight-value { font-family: var(--font-display); font-size: clamp(2.2rem, 1.6rem + 2.5vw, 3.6rem); line-height: 1; color: var(--vino); text-transform: uppercase; }

  .svc-page__list { display: grid; gap: 0.9rem; }
  .svc-page__list h2 { font-weight: 400; color: var(--vino); }
  .svc-page__list .arrow-list { gap: 0.45rem; font-size: 0.92rem; }

  .svc-page__callout { padding: 1.2rem 1.4rem; background: var(--vino); color: var(--base); display: grid; gap: 0.5rem; }
  .svc-page__note { font-size: 0.82rem; padding-top: 1rem; border-top: 1px solid var(--line-soft); }
  .svc-page__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 0.5rem; }

  @media (min-width: 900px) {
    .svc-page__grid { grid-template-columns: 1fr 1fr; }
    .svc-page__photo { position: sticky; top: calc(var(--header-h) + 2rem); }
    .svc-page__text { justify-self: end; margin-right: 4vw; }
  }

  .svc-page__others { margin-top: var(--section-y); display: grid; gap: 1rem; }
  .svc-page__others p { font-size: 0.7rem; }
  .svc-page__others ul { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .svc-page__others li { border-bottom: 1px solid var(--line); }
  .svc-page__others a { display: grid; grid-template-columns: 1fr auto; gap: 0.3rem 1.5rem; align-items: center; padding: 1.3rem 0; text-decoration: none; }
  .svc-page__others-tag { grid-column: 1; font-size: 0.88rem; }
  .svc-page__others :global(.svc-page__arrow) { grid-column: 2; grid-row: 1 / span 2; width: 1.3rem; color: var(--vino); transition: transform 0.3s var(--ease); }
  .svc-page__others a:hover :global(.svc-page__arrow) { transform: rotate(-45deg); }
  .svc-page__others a:hover .tracked-title { color: var(--vino); }
</style>
