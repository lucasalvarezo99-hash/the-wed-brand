---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../config/site';
import { meeting } from '../data/home';
import proceso from '../data/proceso.json';
import faq from '../data/faq.json';
import '../styles/sections.css';

const bookingHref = site.bookingUrl || '/contacto#servicio-reunion';
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title="Proceso" description="Cómo trabajamos en The Wed Brand: nos conocemos, encontramos el concepto, diseñamos la propuesta y le damos vida a la identidad de su casamiento. Preguntas frecuentes." jsonLd={faqLd}>
  <!-- Cómo trabajamos -->
  <section class="section process" aria-labelledby="proceso-title">
    <div class="container">
      <div class="split-head">
        <SectionHead title={['Cómo', 'trabajamos']} id="proceso-title" as="h1" />
        <p class="reveal">{proceso.note}</p>
      </div>
      <ol class="steps">
        {proceso.steps.map((s, i) => (
          <li class="reveal" style={`--delay:${i * 0.07}s`}>
            <span class="tracked">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="tracked-title">{s.title}</h2>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Reunión inicial (lámina bordó) -->
  <section class="section tone-vino on-dark meeting" id="reunion" aria-labelledby="reunion-title">
    <div class="container meeting__inner">
      <h2 class="head__title reveal" id="reunion-title"><span>{meeting.title}</span></h2>
      <p class="meeting__text reveal">{meeting.text}</p>
      <p class="tracked meeting__badge reveal">• {meeting.badge} •</p>
      <p class="reveal">{meeting.note}</p>
      <a class="btn btn--light reveal" href={bookingHref} {...(site.bookingUrl ? { target: '_blank', rel: 'noopener' } : {})}>{meeting.cta}</a>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="section faq" id="preguntas" aria-labelledby="preguntas-title">
    <div class="container faq__grid">
      <SectionHead title={['Preguntas', 'frecuentes']} id="preguntas-title">
        <p>¿Les queda alguna duda? <a class="faq__write" href="/contacto">escríbannos</a></p>
      </SectionHead>
      <div class="faq__list">
        {faq.map((f) => (
          <details class="faq__item">
            <summary><span>{f.q}</span><span class="faq__icon" aria-hidden="true"></span></summary>
            <div class="faq__answer"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
