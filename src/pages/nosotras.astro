---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Isotipo from '../components/Isotipo.astro';
import { philosophy, concept } from '../data/home';
import equipo from '../data/equipo.json';
import fotoEquipo from '../assets/nosotras/cande-y-casu.jpg';
import '../styles/sections.css';
---
<Base title="Nosotras" description="Somos Casu y Cande, las dos personas detrás de The Wed Brand: comunicación, estrategia y contenido, y diseño y dirección visual para casamientos.">
  <!-- Quiénes están detrás (lámina celeste) -->
  <section class="section tone-celeste about" aria-labelledby="nosotras-title">
    <div class="container about__grid">
      <div class="about__text">
        <SectionHead title={equipo.title} id="nosotras-title" as="h1">
          {equipo.paragraphs.map((p) => <p class="justify">{p}</p>)}
        </SectionHead>
        <dl class="about__people reveal">
          {equipo.people.map((person) => (
            <div>
              <dt class="tracked">{person.name} · {person.fullName}</dt>
              {person.links.length > 0 && (
                <dd>{(person.links as { label: string; href: string }[]).map((l) => <a class="bracket-link" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}</dd>
              )}
            </div>
          ))}
        </dl>
      </div>
      <figure class="about__photo reveal">
        <Image src={fotoEquipo} alt={equipo.photoAlt} widths={[340, 680, 1020]} sizes="(min-width: 900px) 340px, 240px" quality={92} loading="eager" />
      </figure>
    </div>
  </section>

  <!-- Por qué creamos este proyecto -->
  <section class="section note" aria-labelledby="filosofia-title">
    <div class="container note__grid">
      <figure class="note__photo reveal">
        <Image src={philosophy.photo.src} alt={philosophy.photo.alt} widths={[320, 480, 640]} sizes="(min-width: 900px) 24vw, 80vw" />
      </figure>
      <div class="note__text">
        <SectionHead title={philosophy.title} id="filosofia-title">
          {philosophy.paragraphs.map((p) => <p class="justify">{p}</p>)}
        </SectionHead>
      </div>
    </div>
    <figure class="quote reveal">
      <figcaption class="tracked">{philosophy.quoteLabel}</figcaption>
      <blockquote><p class="script">«{philosophy.quote}»</p></blockquote>
    </figure>
  </section>

  <!-- Concepto creativo (lámina bordó) -->
  <section class="section tone-vino on-dark concept" aria-labelledby="concepto-title">
    <div class="container concept__grid">
      <div class="concept__logo reveal" aria-hidden="true"><Isotipo /></div>
      <div class="concept__text">
        <p class="tracked">{concept.label}</p>
        <h2 class="head__title reveal" id="concepto-title"><span>{concept.title}</span></h2>
        {concept.paragraphs.map((p) => <p class="justify reveal">{p}</p>)}
      </div>
    </div>
  </section>
</Base>

<script>
  // Alinea el borde superior de la foto con la línea «la identidad de marca, así que creamos The Wed Brand».
  const photo = document.querySelector<HTMLElement>('.about__photo');
  const grid = document.querySelector<HTMLElement>('.about__grid');
  function align() {
    if (!photo || !grid) return;
    if (!matchMedia('(min-width: 900px)').matches) return photo.style.removeProperty('--photo-offset');
    const walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT);
    let node: Node | null;
    while ((node = walker.nextNode())) {
      const i = node.textContent?.indexOf('identidad de marca') ?? -1;
      if (i < 0) continue;
      const range = document.createRange();
      range.setStart(node, i);
      range.setEnd(node, i + 1);
      const top = range.getBoundingClientRect().top - grid.getBoundingClientRect().top;
      photo.style.setProperty('--photo-offset', `${Math.max(0, top)}px`);
      return;
    }
  }
  align();
  addEventListener('resize', align);
  document.fonts?.ready.then(align);
  setTimeout(align, 1200); // tras la animación de aparición
</script>
