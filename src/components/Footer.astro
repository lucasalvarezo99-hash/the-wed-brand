---
/** Pie liviano: una línea con marca, contacto y privacidad. */
import { site } from '../config/site';
const year = new Date().getFullYear();
const wa = site.contact.whatsapp;
---
<footer class="site-footer">
  <div class="container site-footer__inner tracked">
    <span>© {year} [The Wed Brand]</span>
    <span class="site-footer__links">
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      <a href={site.contact.instagram.url} target="_blank" rel="noopener">{site.contact.instagram.handle}</a>
      {wa && <a href={`https://wa.me/${wa}`} target="_blank" rel="noopener">WhatsApp</a>}
      <a href="/privacidad">Privacidad</a>
    </span>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line-soft); padding-block: 1.6rem; background: var(--bg); }
  .site-footer__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.8rem 2rem; font-size: 0.66rem; }
  .site-footer__links { display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; }
  .site-footer a { text-decoration: none; text-transform: none; letter-spacing: 0.08em; font-family: var(--font-body); font-size: 0.78rem; }
  .site-footer a:hover { color: var(--vino); text-decoration: underline; }
</style>
