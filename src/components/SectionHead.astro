---
/**
 * Título de sección minimalista: mayúsculas espaciadas en dos líneas
 * (referencia Kennedy Collective) con texto opcional debajo.
 */
interface Props {
  title: string[];
  id?: string;
  as?: 'h1' | 'h2';
  class?: string;
}
const { title, id, as: Tag = 'h2', class: className } = Astro.props;
---
<header class:list={['head', className]}>
  <Tag class="head__title reveal" id={id}>{title.map((line) => <span>{line}</span>)}</Tag>
  {Astro.slots.has('default') && <div class="head__lead reveal" style="--delay:.1s"><slot /></div>}
</header>
