---
/**
 * Barra superior como el mockup del Brand Book (26. Sitio web):
 * navegación entre corchetes y la marca centrada entre corchetes.
 * Desktop: [menú] [nosotras] [servicios]   [THE WED BRAND]   [portfolio] [proceso] [contacto]
 * Mobile:  [menú]                                            [TWB]
 */
import { site, primaryCta } from '../config/site';

const left = [
  { label: 'nosotras', href: '/#nosotras' },
  { label: 'servicios', href: '/#servicios' },
];
const right = [
  { label: 'portfolio', href: '/#portfolio' },
  { label: 'proceso', href: '/#proceso' },
  { label: 'contacto', href: '/#contacto' },
];
/** Menú completo (se abre con [menú]). */
const full = [
  { label: 'Inicio', href: '/#inicio' },
  { label: 'Nosotras', href: '/#nosotras' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Portfolio', href: '/#portfolio' },
  { label: 'Proceso', href: '/#proceso' },
  { label: 'Preguntas frecuentes', href: '/#preguntas' },
  { label: 'Contacto', href: '/#contacto' },
];
---
<header class="site-header" data-header>
  <nav class="bar" aria-label="Principal">
    <div class="bar__side bar__side--left">
      <button class="bracket-link bar__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span data-menu-label>menú</span>
      </button>
      {left.map((item) => <a class="bracket-link bar__link" href={item.href} data-nav-link>{item.label}</a>)}
    </div>

    <a class="bar__brand" href="/#inicio" aria-label={`${site.name}, inicio`}>
      <span class="bar__brand-full" aria-hidden="true">[The Wed Brand]</span>
      <span class="bar__brand-short" aria-hidden="true">[TWB]</span>
    </a>

    <div class="bar__side bar__side--right">
      {right.map((item) => <a class="bracket-link bar__link" href={item.href} data-nav-link>{item.label}</a>)}
    </div>
  </nav>

  <div class="menu on-dark" id="menu" hidden data-menu>
    <ul class="menu__list">
      {full.map((item, i) => (
        <li>
          <a href={item.href} data-menu-link>
            <span class="mono-sm" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="menu__foot">
      <a class="btn btn--solid" href={primaryCta.href} data-menu-link>{primaryCta.label}</a>
      <p class="mono-sm">
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a><br />
        <a href={site.contact.instagram.url} target="_blank" rel="noopener">{site.contact.instagram.handle}</a>
      </p>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  function setOpen(open: boolean) {
    if (!toggle || !menu || !label) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    label.textContent = open ? 'cerrar' : 'menú';
    document.documentElement.classList.toggle('menu-open', open);
    if (open) menu.querySelector<HTMLElement>('a')?.focus();
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Sección activa
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links
    .map((a) => document.getElementById(a.hash.slice(1)))
    .filter((el): el is HTMLElement => !!el);
  if (sections.length) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((a) =>
            a.hash === `#${entry.target.id}` ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current'),
          );
        }),
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--base);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease);
  }
  .site-header.is-scrolled { border-bottom-color: var(--line); }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    height: var(--header-h);
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    font-size: 0.92rem;
  }
  .bar__side { display: flex; align-items: center; gap: clamp(0.9rem, 1.6vw, 1.8rem); }
  .bar__side--right { justify-content: flex-end; }
  .bar__menu { background: none; border: 0; padding: 0; min-height: 44px; font-size: inherit; }
  .bar__link:global([aria-current='location']) { color: var(--vino); }

  .bar__brand {
    color: var(--vino);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .bar__brand-full { font-size: 1.05rem; letter-spacing: 0.24em; margin-right: -0.24em; }
  .bar__brand-short { display: none; font-size: 1rem; letter-spacing: 0.12em; }

  @media (max-width: 900px) {
    .bar { grid-template-columns: auto 1fr; }
    .bar__link, .bar__side--right { display: none; }
    .bar__brand { justify-self: end; }
    .bar__brand-full { display: none; }
    .bar__brand-short { display: inline; }
  }

  .menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 49;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem var(--gutter) calc(2rem + env(safe-area-inset-bottom));
    background: var(--vino);
    color: var(--base);
    overflow-y: auto;
    animation: menu-in 0.4s var(--ease);
  }
  .menu[hidden] { display: none; }
  .menu__list { list-style: none; padding: 0; max-width: var(--max); width: 100%; margin-inline: auto; }
  .menu__list li { border-bottom: 1px solid color-mix(in srgb, var(--base) 25%, transparent); }
  .menu__list a {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    padding: 0.8rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 5vw, 3.2rem);
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1.1;
    transition: padding-left 0.35s var(--ease);
  }
  .menu__list a:hover { padding-left: 0.6rem; }
  .menu__foot { display: grid; gap: 1.5rem; max-width: var(--max); width: 100%; margin-inline: auto; justify-items: start; }
  .menu__foot a:not(.btn) { text-decoration: none; }
  :global(html.menu-open) { overflow: hidden; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-10px); } }
</style>
