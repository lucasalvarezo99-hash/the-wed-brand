---
/**
 * Barra superior como el mockup del Brand Book (26. Sitio web):
 * navegación entre corchetes y la marca centrada entre corchetes.
 * Desktop: [menú] [nosotras] [servicios]   [THE WED BRAND]   [portfolio] [proceso] [contacto]
 * Mobile:  [menú]                                            [TWB]
 */
import { site, primaryCta, gmailCompose } from '../config/site';
import Isotipo from './Isotipo.astro';

const left = [
  { label: 'nosotras', href: '/nosotras' },
  { label: 'servicios', href: '/servicios' },
];
const right = [
  { label: 'inspiración', href: '/inspiracion' },
  { label: 'proceso', href: '/proceso' },
  { label: 'contacto', href: '/contacto' },
];
/** Menú completo (se abre con [menú]). */
const full = [
  { label: 'Inicio', href: '/' },
  { label: 'Nosotras', href: '/nosotras' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Inspiración', href: '/inspiracion' },
  { label: 'Proceso', href: '/proceso' },
  { label: 'Preguntas frecuentes', href: '/proceso#preguntas' },
  { label: 'Contacto', href: '/contacto' },
];
// Página actual (para marcarla en la barra)
const current = '/' + (Astro.url.pathname.split('/').filter(Boolean)[0] ?? '');
const isCurrent = (href: string) => href === current;
---
<header class="site-header" data-header>
  <nav class="bar" aria-label="Principal">
    <div class="bar__side bar__side--left">
      <button class="bracket-link bar__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span data-menu-label>menú</span>
      </button>
      {left.map((item) => <a class="bracket-link bar__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </div>

    <a class="bar__brand" href="/" aria-label={`${site.name}, inicio`}>
      <Isotipo class="bar__iso" />
      <span class="bar__brand-full" aria-hidden="true">[The Wed Brand]</span>
      <span class="bar__brand-short" aria-hidden="true">[TWB]</span>
    </a>

    <div class="bar__side bar__side--right">
      {right.map((item) => <a class="bracket-link bar__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </div>
  </nav>

  <div class="menu-backdrop" hidden data-menu-backdrop></div>
  <div class="menu on-dark" id="menu" hidden data-menu>
    <ul class="menu__list">
      {full.map((item, i) => (
        <li>
          <a href={item.href} data-menu-link>
            <span class="mono-sm" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="menu__foot">
      <a class="btn btn--light" href={primaryCta.href} data-menu-link>{primaryCta.label}</a>
      <p class="mono-sm">
        <a href={gmailCompose} target="_blank" rel="noopener">{site.contact.email}</a><br />
        <a href={site.contact.instagram.url} target="_blank" rel="noopener">{site.contact.instagram.handle}</a>
      </p>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  const backdrop = document.querySelector<HTMLElement>('[data-menu-backdrop]');
  backdrop?.addEventListener('click', () => setOpen(false));

  function setOpen(open: boolean) {
    if (!toggle || !menu || !label) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    if (backdrop) backdrop.hidden = !open;
    label.textContent = open ? 'cerrar' : 'menú';
    document.documentElement.classList.toggle('menu-open', open);
    if (open) menu.querySelector<HTMLElement>('a')?.focus();
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--base);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease);
  }
  .site-header.is-scrolled { border-bottom-color: var(--line); }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    height: var(--header-h);
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    font-size: 0.92rem;
  }
  .bar__side { display: flex; align-items: center; gap: clamp(0.9rem, 1.6vw, 1.8rem); }
  .bar__side--right { justify-content: flex-end; }
  .bar__menu { background: none; border: 0; padding: 0; min-height: 44px; font-size: inherit; }
  .bar__link[aria-current='page'] { color: var(--vino); text-decoration: underline; text-underline-offset: 0.35em; text-decoration-thickness: 1px; }

  .bar__brand {
    color: var(--vino);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .bar__brand { display: inline-flex; flex-direction: column; align-items: center; gap: 0.25rem; }
  .bar__iso { width: 1.6rem; height: auto; }
  .bar__brand-full { font-size: 1.05rem; letter-spacing: 0.24em; margin-right: -0.24em; }
  .bar__brand-short { display: none; font-size: 1rem; letter-spacing: 0.12em; }

  @media (max-width: 900px) {
    .bar { grid-template-columns: auto 1fr; }
    .bar__link, .bar__side--right { display: none; }
    .bar__brand { justify-self: end; }
    .bar__brand-full { display: none; }
    .bar__brand-short { display: inline; }
  }

  /* Menú lateral: se abre desde la izquierda y deja ver la página al costado */
  .menu-backdrop {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 48;
    background: color-mix(in srgb, var(--grafito) 35%, transparent);
    animation: fade 0.35s var(--ease);
  }
  .menu-backdrop[hidden] { display: none; }
  .menu {
    position: fixed;
    top: var(--header-h);
    bottom: 0;
    left: 0;
    z-index: 49;
    width: min(360px, 86vw);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 1.8rem calc(2rem + env(safe-area-inset-bottom));
    background: var(--vino);
    color: var(--base);
    overflow-y: auto;
    animation: menu-in 0.45s var(--ease);
  }
  .menu[hidden] { display: none; }
  .menu__list { list-style: none; padding: 0; }
  .menu__list li { border-bottom: 1px solid color-mix(in srgb, var(--base) 22%, transparent); }
  .menu__list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: padding-left 0.3s var(--ease);
  }
  .menu__list a:hover { padding-left: 0.4rem; }
  .menu__foot { display: grid; gap: 1.2rem; justify-items: start; font-size: 0.8rem; }
  .menu__foot .btn { min-height: 42px; padding: 0.5rem 1rem; font-size: 0.7rem; }
  .menu__foot a:not(.btn) { text-decoration: none; }
  :global(html.menu-open) { overflow: hidden; }
  @keyframes menu-in { from { transform: translateX(-100%); } }
  @keyframes fade { from { opacity: 0; } }
</style>
